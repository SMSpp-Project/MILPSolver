# This file contains instructions on how to generate the MILPSolverConfig.cmake file

get_filename_component(MILPSolver_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
include(CMakeFindDependencyMacro)

# Do this to use FindCPLEX.cmake
list(APPEND CMAKE_MODULE_PATH ${MILPSolver_CMAKE_DIR})

include(${MILPSolver_CMAKE_DIR}/CMakeConfig.txt OPTIONAL)
find_package(CPLEX)
find_package(SMSpp  REQUIRED)
find_package(Boost  REQUIRED)

list(REMOVE_AT CMAKE_MODULE_PATH -1)

if(NOT TARGET SMS++::MILPSolver)
    include("${MILPSolver_CMAKE_DIR}/MILPSolverTargets.cmake")
endif()

set(MILPSolver_LIBRARIES SMS++::MILPSolver)
