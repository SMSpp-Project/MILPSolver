# this is known in some circles as "the PIntel problem"
# min  - 5 * x_1 - 2 * x_2
# s.t.   2 * x_1 +     x_2 <= 9
#            x_1           <= 4
#                      x_2 <= 7
#            x_1           >= 0
#                      x_2 >= 0
#
2 # number of variables
1 # number of constraints
0 4  # bounds on x_1
0 7  # bounds on x_2
2  # nonzeros in o.f.
0 -5
1 -2
# now first constraint
-INF 9 # lhs and rhs
2  # nonzeros in the constraint
0 2
1 1
# the end
