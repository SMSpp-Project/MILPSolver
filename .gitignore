# ============================================================
#  MILPSolver — .gitignore
# ============================================================

# --- Project-specific ---------------------------------------
# Per-solver parameter dumpers
tools/cpx_pars
tools/grb_pars
tools/scip_pars
tools/highs_pars
tools/.headers.stamp

# Test binaries
test/test_cuts
test/test_dual
test/test_dynamic

# Generated headers (from solver SDKs)
include/*_defs.h
include/*_maps.h

# --- C/C++ build artifacts ----------------------------------
*.o
*.obj
*.d
*.gch
*.pch
*.a
*.lib
*.la
*.lai
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.dSYM/
*.pdb
*.idb
*.ilk
*.map
*.exp
*.gcno
*.gcda

# --- CMake --------------------------------------------------
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeLists.txt.user
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/

# --- IDEs ---------------------------------------------------
.idea/
.vscode/
*.iml
*.iws
out/

# --- OS junk ------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
*~
.directory
.fuse_hidden*
.nfs*
