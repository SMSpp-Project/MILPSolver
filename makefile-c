##############################################################################
################################ makefile-c ##################################
##############################################################################
#                                                                            #
#   complete makefile of MILPSolver                                          #
#                                                                            #
#   The makefile defines internally all external libraries (comprised the    #
#   SMS++ one) required by MILPSolver. Accordingly, all necessary OBJ, H,    #
#   -I directives, external libraries + -L< libdirs > are added to the       #
#   corresponding MILPS* macros.                                             #
#                                                                            #
#   Input:  $(CC)       = compiler command                                   #
#           $(SW)       = compiler options                                   #
#           $(MILPSSDR) = the directory where MILPSolver source is           #
#           $(MILPSODR) = the directory where the objects have to be put     #
#                                                                            #
#   Output: $(MILPSOBJ) = the final object(s) / library                      #
#           $(MILPSLIB) = external libraries + -L< libdirs >                 #
#           $(MILPSH)   = the .h files to include for MILPSolver             #
#           $(MILPSINC) = the -I$( MILPSolver directory )                    #
#                                                                            #
#                              Antonio Frangioni                             #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I< include directories >

# define input macros for SMS++ complete makefile, then include it
SMS++SDR = $(MILPSSDR)/../SMS++
include $(SMS++SDR)/lib/makefile-inc

# include makefile for libCPLEX
include $(MILPSSDR)/../extlib/makefile-libCPLEX

# include makefile for libGUROBI
include $(MILPSSDR)/../extlib/makefile-libGUROBI

# include makefile for libSCIP
include $(MILPSSDR)/../extlib/makefile-libSCIP

# include makefile for libHiGHS
include $(MILPSSDR)/../extlib/makefile-libHiGHS

# include makefile for libPIPS
include $(MILPSSDR)/../extlib/makefile-libPIPS

# include makefile for libDAQP
include $(MILPSSDR)/../extlib/makefile-libDAQP

# include makefile for libqpOASES
include $(MILPSSDR)/../extlib/makefile-libqpOASES

# include makefile for libClarabel
include $(MILPSSDR)/../extlib/makefile-libClarabel

# include makefile for libMOSEK
include $(MILPSSDR)/../extlib/makefile-libMOSEK

# include makefile for libProxSuite
include $(MILPSSDR)/../extlib/makefile-libProxSuite

# include makefile for libPIQP
include $(MILPSSDR)/../extlib/makefile-libPIQP

# include makefile for libOSQP
include $(MILPSSDR)/../extlib/makefile-libOSQP

# include makefile for libqpmad
include $(MILPSSDR)/../extlib/makefile-libqpmad

# include the makefile requiring all external modules in input
include $(MILPSSDR)/makefile

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external -I directives to MILPSINC, MILPSOBJ and MILPSH as defined
# by the makefile, thus the := assignment has to be used (use GNU make)
MILPSOBJ := $(MILPSOBJ) $(SMS++OBJ)
MILPSINC := $(MILPSINC) $(SMS++INC) $(libCPLEXINC) $(libGUROBIINC) \
	$(libHiGHSINC) $(libSCIPINC)

# external libraries for MILPSolver
MILPSLIB = $(SMS++LIB) $(libCPLEXLIB) $(libGUROBILIB) $(libHiGHSLIB) \
	$(libSCIPLIB)

# append PIPS-IPM++ flags only when its source tree is available
ifneq ($(wildcard $(PIPSROOT)/Core/Interface/PIPSIPMppInterface.hpp),)
    MILPSINC := $(MILPSINC) $(libPIPSINC)
    MILPSLIB := $(MILPSLIB) $(libPIPSLIB)
endif

# append DAQP flags only when it is installed
ifneq ($(DAQP_PRESENT),)
    MILPSINC := $(MILPSINC) $(libDAQPINC)
    MILPSLIB := $(MILPSLIB) $(libDAQPLIB)
endif

# append qpOASES flags only when it is installed
ifneq ($(QPOASES_PRESENT),)
    MILPSINC := $(MILPSINC) $(libqpOASESINC)
    MILPSLIB := $(MILPSLIB) $(libqpOASESLIB)
endif

# append Clarabel flags only when it is installed
ifneq ($(CLARABEL_PRESENT),)
    MILPSINC := $(MILPSINC) $(libClarabelINC)
    MILPSLIB := $(MILPSLIB) $(libClarabelLIB)
endif

# append MOSEK flags only when it is installed
ifneq ($(MOSEK_PRESENT),)
    MILPSINC := $(MILPSINC) $(libMOSEKINC)
    MILPSLIB := $(MILPSLIB) $(libMOSEKLIB)
endif

# append the ProxSuite flags only when it is installed (it is header-only)
ifneq ($(ProxSuite_PRESENT),)
    MILPSINC := $(MILPSINC) $(libProxSuiteINC)
endif

# append PIQP flags only when it is installed
ifneq ($(PIQP_PRESENT),)
    MILPSINC := $(MILPSINC) $(libPIQPINC)
    MILPSLIB := $(MILPSLIB) $(libPIQPLIB)
endif

# append OSQP flags only when it is installed
ifneq ($(OSQP_PRESENT),)
    MILPSINC := $(MILPSINC) $(libOSQPINC)
    MILPSLIB := $(MILPSLIB) $(libOSQPLIB)
endif

# append the qpmad flags only when it is installed (it is header-only)
ifneq ($(QPMAD_PRESENT),)
    MILPSINC := $(MILPSINC) $(libqpmadINC)
endif

############################ End of makefile #################################
